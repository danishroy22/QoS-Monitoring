# Copy to backend/.env and adjust as needed.

# Database connection.
# Default (out-of-the-box, no server required): local SQLite file.
QOS_DATABASE_URL=sqlite:///./qos_monitoring.db

# Phase 3 — Supabase Postgres (overrides QOS_DATABASE_URL when set).
# Dashboard → Connect → Session pooler (IPv4). Prefer this over Direct connection
# (db.<ref>.supabase.co is often IPv6-only and fails on many Windows networks).
# Pooler username is postgres.<project-ref>. Scheme must be postgresql+psycopg.
# Example:
# QOS_SUPABASE_DB_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# When Supabase is unreachable, the backend falls back to local SQLite.
# Local PostgreSQL example:
# QOS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/qos_monitoring

# Phase 3 — privacy / traceability
QOS_CLIENT_HASH_SALT=replace-with-a-long-random-string
QOS_STORE_PUBLIC_IP=true

# API metadata
QOS_APP_NAME=ai-broadband-qos-backend
QOS_API_PREFIX=/api

# CORS: comma-separated origins allowed to call the API (React dev server).
QOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the default simulator nodes on startup (true/false).
QOS_SEED_NODES=true

# Phase 6 — Generative AI (optional).
# Leave QOS_OPENAI_API_KEY empty to use the offline telecom fallback generator.
# QOS_OPENAI_API_KEY=sk-...
# QOS_OPENAI_BASE_URL=https://api.openai.com/v1
# QOS_OPENAI_MODEL=gpt-4o-mini
# QOS_AI_FORCE_FALLBACK=false
# QOS_AI_TIMEOUT_SECONDS=30

# Phase 15 — role-based portal access (optional enforcement).
# When false (default), demos work without tokens; send X-SmartQoS-Role / Token / ISP to switch roles.
# QOS_AUTH_REQUIRED=false
# QOS_ADMIN_TOKEN=admin-demo-token
# QOS_ISP_TOKENS=Emtel:emtel-demo-token,Rogers:rogers-demo-token,Mauritius Telecom / Orange:mt-demo-token
